# Copy to `.env` and adjust. Run commands from the `backend/` directory so this file is loaded.

# PostgreSQL — SQLAlchemy + psycopg v3 (see requirements.txt; not psycopg2-binary).
# From your host machine (uvicorn on localhost):
DATABASE_URL=postgresql+psycopg://pait:pait@localhost:5432/pait
# From another Docker Compose service on the same network, use the DB service hostname `db`:
# DATABASE_URL=postgresql+psycopg://pait:pait@db:5432/pait

APP_ENV=development
SOURCE_FETCH_USER_AGENT=PersonalAIIntelligenceTool/0.1 (+local-dev)

# Reserved for later features (not used by the app yet)
# OPENAI_API_KEY=
# REDIS_URL=

# Resend — digest email delivery (https://resend.com)
# RESEND_API_KEY=re_...
# RESEND_FROM=Sipply <digest@sipply.dev>
# Operator emails: a failed pipeline stage, and a summary of the last 24 hours on the
# evening run (scripts/run_pipeline.py → app/services/alerts.py). Unset = none sent.
# ALERT_EMAIL=you@example.com
# Trend Radar YouTube source (YouTube Data API v3, free 10,000 units/day).
# The source is skipped while unset; HN and Google News need no key.
# YOUTUBE_API_KEY=

# Trend Radar Bluesky source: your handle + an app password
# (bsky.app → Settings → Privacy and security → App passwords). Skipped while unset.
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=

# Trend Radar Threads source: long-lived token from a Meta app with the
# threads_keyword_search permission (expires after 60 days). Skipped while unset.
# THREADS_ACCESS_TOKEN=

# Only the cron run starting at this UTC hour sends the digest email (must be an
# hour in railway.cron.toml's cronSchedule). Default 20 = last run of the day.
# DIGEST_EMAIL_HOUR_UTC=20
